{
  "name": "@openexperiments/mcp-server",
  "version": "1.2.0",
  "description": "MCP server for OpenExperiments — hypothesis formulation, dataset discovery, and research exploration",
  "type": "module",
  "bin": {
    "openexperiments-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
